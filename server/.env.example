# --- Server ---
PORT=5000

# --- MongoDB ---
# Local: mongodb://127.0.0.1:27017/cityofpalms
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/cityofpalms
MONGODB_URI=mongodb://127.0.0.1:27017/cityofpalms

# --- Email notifications (optional; leave blank to skip sending) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=enquiries@example.com
